import os

from ament_index_python.packages import get_package_share_directory
from launch import LaunchDescription
from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription, OpaqueFunction, RegisterEventHandler, TimerAction
from launch.conditions import IfCondition
from launch.event_handlers import OnProcessExit
from launch.launch_description_sources import PythonLaunchDescriptionSource
from launch.substitutions import Command, LaunchConfiguration, PathJoinSubstitution
from launch_ros.actions import Node


def declare_world_action(context, world_name):
  world_name_str = str(world_name.perform(context))
  declare_world = DeclareLaunchArgument(
      'world',
      default_value=[os.path.join(
          get_package_share_directory('vehicle_simulator'),
          'world', world_name_str + '.world')],
      description='')
  return [declare_world]


def generate_launch_description():
  sensorOffsetX = LaunchConfiguration('sensorOffsetX')
  sensorOffsetY = LaunchConfiguration('sensorOffsetY')
  vehicleHeight = LaunchConfiguration('vehicleHeight')
  cameraOffsetZ = LaunchConfiguration('cameraOffsetZ')
  vehicleX = LaunchConfiguration('vehicleX')
  vehicleY = LaunchConfiguration('vehicleY')
  vehicleZ = LaunchConfiguration('vehicleZ')
  terrainZ = LaunchConfiguration('terrainZ')
  vehicleYaw = LaunchConfiguration('vehicleYaw')
  terrainVoxelSize = LaunchConfiguration('terrainVoxelSize')
  groundHeightThre = LaunchConfiguration('groundHeightThre')
  adjustZ = LaunchConfiguration('adjustZ')
  terrainRadiusZ = LaunchConfiguration('terrainRadiusZ')
  minTerrainPointNumZ = LaunchConfiguration('minTerrainPointNumZ')
  smoothRateZ = LaunchConfiguration('smoothRateZ')
  adjustIncl = LaunchConfiguration('adjustIncl')
  terrainRadiusIncl = LaunchConfiguration('terrainRadiusIncl')
  minTerrainPointNumIncl = LaunchConfiguration('minTerrainPointNumIncl')
  smoothRateIncl = LaunchConfiguration('smoothRateIncl')
  InclFittingThre = LaunchConfiguration('InclFittingThre')
  maxIncl = LaunchConfiguration('maxIncl')
  lidar_urdf = LaunchConfiguration('lidar_urdf')
  robot_urdf = LaunchConfiguration('robot_urdf')
  pause = LaunchConfiguration('pause')
  use_sim_time = LaunchConfiguration('use_sim_time')
  gui = LaunchConfiguration('gui')
  record = LaunchConfiguration('record')
  verbose = LaunchConfiguration('verbose')
  world_name = LaunchConfiguration('world_name')
  start_gazebo = LaunchConfiguration('start_gazebo')
  robot_model_name = LaunchConfiguration('robot_model_name')
  lidar_model_name = LaunchConfiguration('lidar_model_name')
  camera_model_name = LaunchConfiguration('camera_model_name')
  mapFrame = LaunchConfiguration('mapFrame')
  sensorFrame = LaunchConfiguration('sensorFrame')
  scan_topic = LaunchConfiguration('scan_topic')
  tf_prefix = LaunchConfiguration('tf_prefix')
  sensor_name = LaunchConfiguration('sensor_name')
  parent_link = LaunchConfiguration('parent_link')

  declares = [
    DeclareLaunchArgument('sensorOffsetX', default_value='0.0'),
    DeclareLaunchArgument('sensorOffsetY', default_value='0.0'),
    DeclareLaunchArgument('vehicleHeight', default_value='0.75'),
    DeclareLaunchArgument('cameraOffsetZ', default_value='0.0'),
    DeclareLaunchArgument('vehicleX', default_value='0.0'),
    DeclareLaunchArgument('vehicleY', default_value='0.0'),
    DeclareLaunchArgument('vehicleZ', default_value='0.0'),
    DeclareLaunchArgument('terrainZ', default_value='0.0'),
    DeclareLaunchArgument('vehicleYaw', default_value='0.0'),
    DeclareLaunchArgument('terrainVoxelSize', default_value='0.05'),
    DeclareLaunchArgument('groundHeightThre', default_value='0.1'),
    DeclareLaunchArgument('adjustZ', default_value='true'),
    DeclareLaunchArgument('terrainRadiusZ', default_value='1.0'),
    DeclareLaunchArgument('minTerrainPointNumZ', default_value='5'),
    DeclareLaunchArgument('smoothRateZ', default_value='0.5'),
    DeclareLaunchArgument('adjustIncl', default_value='true'),
    DeclareLaunchArgument('terrainRadiusIncl', default_value='2.0'),
    DeclareLaunchArgument('minTerrainPointNumIncl', default_value='200'),
    DeclareLaunchArgument('smoothRateIncl', default_value='0.5'),
    DeclareLaunchArgument('InclFittingThre', default_value='0.2'),
    DeclareLaunchArgument('maxIncl', default_value='30.0'),
    DeclareLaunchArgument('lidar_urdf', default_value='urdf/lidar.urdf.xacro'),
    DeclareLaunchArgument('robot_urdf', default_value='urdf/robot.sdf'),
    DeclareLaunchArgument('pause', default_value='false'),
    DeclareLaunchArgument('use_sim_time', default_value='false'),
    DeclareLaunchArgument('gui', default_value='false'),
    DeclareLaunchArgument('record', default_value='false'),
    DeclareLaunchArgument('verbose', default_value='false'),
    DeclareLaunchArgument('world_name', default_value='garage'),
    DeclareLaunchArgument('start_gazebo', default_value='true'),
    DeclareLaunchArgument('robot_model_name', default_value='robot'),
    DeclareLaunchArgument('lidar_model_name', default_value='lidar'),
    DeclareLaunchArgument('camera_model_name', default_value='camera'),
    DeclareLaunchArgument('mapFrame', default_value='map'),
    DeclareLaunchArgument('sensorFrame', default_value='sensor'),
    DeclareLaunchArgument('scan_topic', default_value='/velodyne_points'),
    DeclareLaunchArgument('tf_prefix', default_value=''),
    DeclareLaunchArgument('sensor_name', default_value='velodyne'),
    DeclareLaunchArgument('parent_link', default_value='lidar'),
    DeclareLaunchArgument('robot_ns', default_value=''),
    DeclareLaunchArgument('camera_frame', default_value='camera'),
  ]

  lidar_xacro = PathJoinSubstitution([
      get_package_share_directory('vehicle_simulator'), lidar_urdf])
  lidar_description = Command([
      'xacro ', lidar_xacro,
      ' scan_topic:=', scan_topic,
      ' tf_prefix:=', tf_prefix,
      ' sensor_name:=', sensor_name,
      ' parent_link:=', parent_link,
  ])
  start_lidar_state_publisher = Node(
    package='robot_state_publisher',
    executable='robot_state_publisher',
    name='lidar_state_publisher',
    output='screen',
    parameters=[{
      'use_sim_time': use_sim_time,
      'robot_description': lidar_description
    }]
  )

  start_gazebo_include = IncludeLaunchDescription(
    PythonLaunchDescriptionSource(os.path.join(
      get_package_share_directory('gazebo_ros'), 'launch', 'gazebo.launch.py')),
    condition=IfCondition(start_gazebo),
  )

  ld = LaunchDescription()
  for item in declares:
    ld.add_action(item)
  ld.add_action(OpaqueFunction(function=declare_world_action, args=[world_name]))
  ld.add_action(start_gazebo_include)
  ld.add_action(start_lidar_state_publisher)
  # TimerAction cannot substitute LaunchConfiguration from an included
  # launch file; resolve names here then delay the already-built nodes.
  ld.add_action(OpaqueFunction(function=schedule_delayed_nodes))
  return ld


def _cfg(context, name):
  return LaunchConfiguration(name).perform(context)


def _cfg_float(context, name):
  return float(_cfg(context, name))


def _cfg_bool(context, name):
  return _cfg(context, name).lower() in ('true', '1', 'yes')


def schedule_delayed_nodes(context, *args, **kwargs):
  import subprocess
  import tempfile

  pkg_share = get_package_share_directory('vehicle_simulator')
  ns = _cfg(context, 'robot_ns')
  lidar_name = _cfg(context, 'lidar_model_name')
  robot_name = _cfg(context, 'robot_model_name')
  camera_name = _cfg(context, 'camera_model_name')
  robot_file = os.path.join(pkg_share, _cfg(context, 'robot_urdf'))
  camera_xacro = os.path.join(pkg_share, 'urdf', 'camera.urdf.xacro')
  lidar_xacro = os.path.join(pkg_share, _cfg(context, 'lidar_urdf'))
  lidar_urdf = os.path.join(
      tempfile.gettempdir(), f'{lidar_name.replace("/", "_")}.urdf')
  camera_urdf = os.path.join(
      tempfile.gettempdir(), f'{camera_name.replace("/", "_")}.urdf')
  ros_ns = f'/{ns}' if ns else ''
  subprocess.check_call([
      'xacro', lidar_xacro,
      f'scan_topic:={_cfg(context, "scan_topic")}',
      f'tf_prefix:={_cfg(context, "tf_prefix")}',
      f'sensor_name:={_cfg(context, "sensor_name")}',
      f'parent_link:={_cfg(context, "parent_link")}',
      '-o', lidar_urdf,
  ])
  subprocess.check_call([
      'xacro', camera_xacro,
      f'name:={camera_name}',
      f'ros_namespace:={ros_ns}',
      f'frame_name:={_cfg(context, "camera_frame")}',
      '-o', camera_urdf,
  ])

  spawn_timeout = '300'
  spawn_lidar = Node(
    package='gazebo_ros',
    executable='spawn_entity.py',
    name='spawn_lidar',
    arguments=[
      '-entity', lidar_name,
      '-file', lidar_urdf,
      '-timeout', spawn_timeout,
    ],
    output='screen',
  )
  spawn_robot = Node(
    package='gazebo_ros',
    executable='spawn_entity.py',
    name='spawn_robot',
    arguments=[
      '-file', robot_file,
      '-entity', robot_name,
      '-timeout', spawn_timeout,
    ],
    output='screen',
  )
  spawn_camera = Node(
    package='gazebo_ros',
    executable='spawn_entity.py',
    name='spawn_camera',
    arguments=[
      '-file', camera_urdf,
      '-entity', camera_name,
      '-timeout', spawn_timeout,
    ],
    output='screen',
  )
  start_vehicle_simulator = Node(
    package='vehicle_simulator',
    executable='vehicleSimulator',
    namespace=ns,
    parameters=[{
      'use_gazebo_time': False,
      'sensorOffsetX': _cfg_float(context, 'sensorOffsetX'),
      'sensorOffsetY': _cfg_float(context, 'sensorOffsetY'),
      'vehicleHeight': _cfg_float(context, 'vehicleHeight'),
      'cameraOffsetZ': _cfg_float(context, 'cameraOffsetZ'),
      'vehicleX': _cfg_float(context, 'vehicleX'),
      'vehicleY': _cfg_float(context, 'vehicleY'),
      'vehicleZ': _cfg_float(context, 'vehicleZ'),
      'terrainZ': _cfg_float(context, 'terrainZ'),
      'vehicleYaw': _cfg_float(context, 'vehicleYaw'),
      'terrainVoxelSize': _cfg_float(context, 'terrainVoxelSize'),
      'groundHeightThre': _cfg_float(context, 'groundHeightThre'),
      'adjustZ': _cfg_bool(context, 'adjustZ'),
      'terrainRadiusZ': _cfg_float(context, 'terrainRadiusZ'),
      'minTerrainPointNumZ': int(_cfg_float(context, 'minTerrainPointNumZ')),
      'smoothRateZ': _cfg_float(context, 'smoothRateZ'),
      'adjustIncl': _cfg_bool(context, 'adjustIncl'),
      'terrainRadiusIncl': _cfg_float(context, 'terrainRadiusIncl'),
      'minTerrainPointNumIncl': int(_cfg_float(context, 'minTerrainPointNumIncl')),
      'smoothRateIncl': _cfg_float(context, 'smoothRateIncl'),
      'InclFittingThre': _cfg_float(context, 'InclFittingThre'),
      'maxIncl': _cfg_float(context, 'maxIncl'),
      'use_sim_time': _cfg_bool(context, 'use_sim_time'),
      'mapFrame': _cfg(context, 'mapFrame'),
      'sensorFrame': _cfg(context, 'sensorFrame'),
      'robotModelName': robot_name,
      'lidarModelName': lidar_name,
      'cameraModelName': camera_name,
    }],
    output='screen',
  )
  return [
    spawn_lidar,
    spawn_robot,
    spawn_camera,
    RegisterEventHandler(
      OnProcessExit(target_action=spawn_robot, on_exit=[start_vehicle_simulator]),
    ),
  ]
